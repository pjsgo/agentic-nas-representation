{
  "unit": "UnitA",
  "stage_a": "forward method (first part)",
  "project_a": "F.linear(x, self.p0, self.p1)",
  "partition_a": "torch.split(proj_a, [8, 8, 8], dim=2)",
  "shape_q": "q_raw.reshape(B, T, 2, 4)",
  "shape_k": "k_raw.reshape(B, T, 2, 4)",
  "shape_v": "v_raw.reshape(B, T, 2, 4)",
  "order_q": "q.permute(0, 2, 1, 3)",
  "order_k": "k.permute(0, 2, 1, 3)",
  "order_v": "v.permute(0, 2, 1, 3)",
  "scale_value": "torch.tensor(0.5, dtype=torch.float32, device=x.device)",
  "scale_q": "q * scale",
  "turn_k": "k.transpose(2, 3)",
  "score_a": "torch.matmul(q, k)",
  "mask_shape_a": "mask.unsqueeze(0)",
  "mask_shape_b": "mask_a.unsqueeze(0)",
  "apply_mask": "scores.masked_fill(mask_b, float('-inf'))",
  "prob_a": "F.softmax(scores, dim=3)",
  "mix_a": "torch.matmul(probs, v)",
  "order_mix": "mixed.permute(0, 2, 1, 3)",
  "join_a": "mixed.reshape(B, T, 8)",
  "project_b": "F.linear(joined, self.p2, self.p3)",
  "stage_b": "forward method (second part)",
  "expand_a": "F.linear(norm_a, self.p6, self.p7)",
  "activate_a": "F.relu(expanded)",
  "contract_a": "F.linear(activated, self.p8, self.p9)",
  "merge_a": "x + stage_a_out",
  "normalize_a": "F.layer_norm(merged_a, [8], self.p4, self.p5, eps=1e-5)",
  "merge_b": "norm_a + stage_b_out",
  "normalize_b": "F.layer_norm(merged_b, [8], self.p10, self.p11, eps=1e-5)",
  "parameters.p0": "self.p0",
  "parameters.p1": "self.p1",
  "parameters.p2": "self.p2",
  "parameters.p3": "self.p3",
  "parameters.p4": "self.p4",
  "parameters.p5": "self.p5",
  "parameters.p6": "self.p6",
  "parameters.p7": "self.p7",
  "parameters.p8": "self.p8",
  "parameters.p9": "self.p9",
  "parameters.p10": "self.p10",
  "parameters.p11": "self.p11"
}
